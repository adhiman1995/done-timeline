# Copy to server/.env for local development.

# Postgres connection string.
#   Local (npm run db:start):  postgres://localhost:5433/donetimeline
#   Neon / Supabase / Render:  postgres://user:pass@host/db?sslmode=require
DATABASE_URL=postgres://localhost:5433/donetimeline

# Secret shared by the web app and the Android app. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_TOKEN=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the API from a browser.
# Use your GitHub Pages origin in production, e.g. https://<user>.github.io
ALLOWED_ORIGINS=http://localhost:5173
