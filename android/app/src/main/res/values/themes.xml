<resources>
    <!-- Window theme only; all UI colours come from Compose (ui/theme). -->
    <style name="Theme.DoneTimeline" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch splash: the Ticked mark on brand blue (Android 12+ API, back-ported by core-splashscreen). -->
    <style name="Theme.Ticked.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DoneTimeline</item>
    </style>
</resources>
